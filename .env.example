# Base URL of the ride-efficiency-api, WITHOUT the /v1 suffix
# (the client appends it). Any EXPO_PUBLIC_* variable is embedded in the bundle,
# so never put secrets here — the token is obtained at runtime and stored in the
# device Keychain.
#
# Local development:
#   1. php artisan serve  (in the ride-efficiency-api repository)
#   2. Use your machine's LAN IP so a physical phone can reach it.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
